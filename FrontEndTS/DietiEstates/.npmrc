# Minimal, supported npm configuration
# Enforce exact dependency versions for reproducibility
save-exact=true

# Ensure package-lock.json is generated and updated
package-lock=true

# Strict peer dependency resolution
legacy-peer-deps=false
strict-peer-deps=true

# Security: audit packages during install
audit=true

# Note: removed unsupported/ineffective keys (lockfile-version, auto-install-peers, ci, package-lock-only)
# and removed prefer-offline to avoid stale cached installs